{
    "bind_address": "0.0.0.0",
    "port": "8282",
    "url_base": "",
    "app_url": "http://decypharr.private.svc.cluster.local:8282",
    "log_level": "info",
    "use_auth": true,
    "enable_webdav_auth": false,
    "mount": {
        "type": "none"
    },
    "download_folder": "/data/decypharr-downloads",
    "default_download_action": "strm",
    "folder_naming": "filename",
    "max_active_downloads": 5,
    "debrids": [],
    "arrs": [
        {
            "name": "Radarr",
            "host": "http://radarr.private.svc.cluster.local:7878",
            "download_uncached": false
        },
        {
            "name": "Sonarr",
            "host": "http://sonarr.private.svc.cluster.local:8989",
            "download_uncached": false
        }
    ],
    "queue_cleanup": {
        "rules": [
            {
                "id": "failed_download",
                "action": "blacklist_research"
            },
            {
                "id": "title_mismatch",
                "action": "import"
            },
            {
                "id": "matched_by_id",
                "action": "import"
            },
            {
                "id": "unable_to_parse",
                "action": "blacklist_research"
            },
            {
                "id": "no_eligible_files",
                "action": "blacklist_research"
            },
            {
                "id": "episodes_missing",
                "action": "blacklist_research"
            },
            {
                "id": "file_empty",
                "action": "blacklist_research"
            }
        ]
    },
    "repair": {
        "enabled": true,
        "source": "managed",
        "schedule": "30 5 * * *",
        "workers": 5,
        "strategy": "per_entry",
        "recheck_interval": "168h",
        "auto_repair": false,
        "skip_nzb_repair": false,
        "verify_content": false
    },
    "usenet": {
        "providers": [],
        "max_connections": 15,
        "processing_max_connections": 15,
        "read_ahead": "16MB",
        "conn_idle_timeout": "5m",
        "processing_timeout": "10m",
        "availability_sample_percent": 10,
        "import_availability_sample_percent": 1,
        "disk_buffer_path": "/cache/usenet",
        "skip_repair": false,
        "buffer_memory": "512MB"
    }
}
