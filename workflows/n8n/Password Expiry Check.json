    {
      "id": "384ae7c6-6214-4edf-a266-adb185177081",
      "name": "Get 7-Day Reminders",
      "type": "n8n-nodes-base.postgres",
      "position": [
        368,
        -368
      ],
      "parameters": {
        "query": "SELECT id, authentik_user_id, username, name, email, temp_password_set_at \nFROM donors \nWHERE status = 'active' \n  AND password_changed_at IS NULL \n  AND temp_password_set_at <= NOW() - INTERVAL '7 days';",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "yPSJ6t0yTl3JfbWz",
          "name": "Postgres"
        }
      },
      "typeVersion": 2.3
    },
    {
      "id": "3706a8c0-8005-4e55-9b6a-64c2c104387f",
      "name": "Send Reminder Email",
      "type": "n8n-nodes-base.emailSend",
      "position": [
        576,
        -368
      ],
      "webhookId": "d8a6eb5e-b668-4e8d-8436-52d0fd19c436",
      "parameters": {
        "html": "=<div style=\"background-color:#08090F;padding:26px 12px;width:100%;\">\n  <div style=\"max-width:560px;margin:0 auto;background-color:#121320;border:1px solid #24273A;border-radius:16px;padding:28px 26px 24px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.7;color:#C9CCE4;\">\n      <!-- Preheader: hidden preview text shown in the inbox list -->\n  <div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">\n    Your temporary password is still active — please change it soon.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;\n  </div>\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#08120F\" style=\"width:100%;background-color:#08120F;\">\n    <tr>\n      <td align=\"center\" style=\"padding:40px 20px;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:560px;background-color:#121320;border:1px solid #24273A;border-radius:16px;\">\n          <!-- Header -->\n          <tr>\n            <td align=\"center\" bgcolor=\"#121320\" style=\"background-color:#121320;background:linear-gradient(135deg,#121320,#08120F);padding:40px 32px 24px;border-bottom:1px solid #16282B;\">\n              <div style=\"font-size:28px;font-weight:700;color:#45D6C8;letter-spacing:-0.5px;\">MySweetPea</div>\n              <div style=\"font-size:13px;color:#A9AFC9;margin-top:4px;\">Self-hosted with care</div>\n            </td>\n          </tr>\n          <!-- Body -->\n          <tr>\n            <td style=\"padding:32px;\">\n              <h1 style=\"margin:0 0 16px;font-size:20px;font-weight:600;color:#EEF0FB;\">Still on a temporary password</h1><p style=\"margin:0 0 24px;font-size:15px;line-height:1.7;color:#A9AFC9;\">Hi {{ $json.name }},</p><p style=\"margin:0 0 24px;font-size:15px;line-height:1.7;color:#A9AFC9;\">You are still signing in with the temporary password from your welcome email. Could you change it when you get a minute? Sign in, open Account, and set a new one.</p><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#1C1416\" style=\"background-color:#1C1416;border:1px solid #3A1E20;border-radius:8px;margin-bottom:24px;\">\n      <tr><td style=\"padding:14px 18px;font-size:13px;color:#E85E5E;line-height:1.6;\">If it is still temporary 14 days after you signed up, I will lock the account until you get in touch. Nothing gets deleted.</td></tr>\n    </table><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n      <tr>\n        <td align=\"center\" style=\"padding:8px 0 24px;\">\n          <!--[if mso]>\n          <v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\" href=\"https://dashboard.mysweetpea.cc\" style=\"height:48px;v-text-anchor:middle;width:240px;\" arcsize=\"12%\" stroke=\"f\" fillcolor=\"#45D6C8\">\n            <w:anchorlock/>\n            <center style=\"color:#08120F;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:600;\">Change it now</center>\n          </v:roundrect>\n          <![endif]-->\n          <!--[if !mso]><!-->\n          <a href=\"https://dashboard.mysweetpea.cc\" style=\"display:inline-block;padding:14px 40px;background-color:#45D6C8;color:#08120F;font-size:15px;font-weight:600;text-decoration:none;border-radius:10px;\">Change it now</a>\n          <!--<![endif]-->\n        </td>\n      </tr>\n    </table><p style=\"margin:margin:0;;font-size:15px;line-height:1.7;color:#A9AFC9;\">If you have already changed it, ignore this email. Sorry for the noise.<br>— Sweet Pea</p>\n            </td>\n          </tr>\n          <!-- Footer -->\n          <tr>\n            <td style=\"padding:24px 32px;border-top:1px solid #16282B;text-align:center;\">\n              <p style=\"margin:0;font-size:12px;color:#9BA1C7;line-height:18px;\">© 2026 MySweetPea. Self-hosted with care.</p>\n              \n            </td>\n          </tr>\n        </table>\n        <p style=\"margin:16px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#9BA1C7;text-align:center;\">Made at home, kept for the people who use it.</p>\n      </td>\n    </tr>\n  </table>\n  </div>\n</div>",
        "text": "=Your temporary password is still active.\n\nHi {{ $json.name }},\n\nYou are still signing in with the temporary password from your welcome email. Could you change it when you get a minute? Sign in at https://dashboard.mysweetpea.cc, open Account, and set a new one.\n\nIf it is still temporary 14 days after you signed up, I will lock the account until you get in touch. Nothing gets deleted.\n\nIf you have already changed it, ignore this email. Sorry for the noise.\n\n— Sweet Pea\nMySweetPea · https://mysweetpea.cc",
        "options": {},
        "subject": "Still on a temporary password",
        "toEmail": "={{ $json.email }}",
        "fromEmail": "support@mysweetpea.cc",
        "emailFormat": "both"
      },
      "credentials": {
        "smtp": {
          "id": "WSuKgfMAW4A3KDug",
          "name": "Resend"
        }
      },
      "typeVersion": 2
    },
