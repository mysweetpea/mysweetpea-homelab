    {
      "id": "2e9c75ab-01c3-470e-95a8-aa35fdc00573",
      "name": "Email Suspension Notice",
      "type": "n8n-nodes-base.emailSend",
      "position": [
        976,
        -128
      ],
      "webhookId": "44a47e51-b478-4575-b080-94c547e7b208",
      "parameters": {
        "html": "=<div style=\"background-color:#08090F;padding:26px 12px;width:100%;\">\n  <div style=\"max-width:560px;margin:0 auto;background-color:#121320;border:1px solid #24273A;border-radius:16px;padding:28px 26px 24px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.7;color:#C9CCE4;\">\n      <!-- Preheader: hidden preview text shown in the inbox list -->\n  <div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">\n    Your account was suspended for security — contact us to reactivate.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;\n  </div>\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#08120F\" style=\"width:100%;background-color:#08120F;\">\n    <tr>\n      <td align=\"center\" style=\"padding:40px 20px;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:560px;background-color:#121320;border:1px solid #24273A;border-radius:16px;\">\n          <!-- Header -->\n          <tr>\n            <td align=\"center\" bgcolor=\"#121320\" style=\"background-color:#121320;background:linear-gradient(135deg,#121320,#08120F);padding:40px 32px 24px;border-bottom:1px solid #16282B;\">\n              <div style=\"font-size:28px;font-weight:700;color:#45D6C8;letter-spacing:-0.5px;\">MySweetPea</div>\n              <div style=\"font-size:13px;color:#A9AFC9;margin-top:4px;\">Self-hosted with care</div>\n            </td>\n          </tr>\n          <!-- Body -->\n          <tr>\n            <td style=\"padding:32px;\">\n              <h1 style=\"margin:0 0 16px;font-size:20px;font-weight:600;color:#EEF0FB;\">Your account is on hold</h1><p style=\"margin:0 0 24px;font-size:15px;line-height:1.7;color:#A9AFC9;\">Hi {{ $json.name }},</p><p style=\"margin:0 0 24px;font-size:15px;line-height:1.7;color:#A9AFC9;\">I locked your account because it was still using the temporary password after 14 days. Nothing is lost. Your files and watch history are where you left them.</p><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#1C1416\" style=\"background-color:#1C1416;border:1px solid #3A1E20;border-radius:8px;margin-bottom:24px;\">\n      <tr><td style=\"padding:14px 18px;font-size:13px;color:#E85E5E;line-height:1.6;\">Reply to this email and I will unlock it. Then sign in and set a new password.</td></tr>\n    </table><p style=\"margin:0 0 24px;font-size:15px;line-height:1.7;color:#A9AFC9;\">Sorry for the hassle. This is only so nobody else can get in with an old password.</p><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n      <tr>\n        <td align=\"center\" style=\"padding:8px 0 24px;\">\n          <!--[if mso]>\n          <v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\" href=\"mailto:support@mysweetpea.cc\" style=\"height:48px;v-text-anchor:middle;width:240px;\" arcsize=\"12%\" stroke=\"f\" fillcolor=\"#45D6C8\">\n            <w:anchorlock/>\n            <center style=\"color:#08120F;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:600;\">Email me</center>\n          </v:roundrect>\n          <![endif]-->\n          <!--[if !mso]><!-->\n          <a href=\"mailto:support@mysweetpea.cc\" style=\"display:inline-block;padding:14px 40px;background-color:#45D6C8;color:#08120F;font-size:15px;font-weight:600;text-decoration:none;border-radius:10px;\">Email me</a>\n          <!--<![endif]-->\n        </td>\n      </tr>\n    </table><p style=\"margin:margin:0;;font-size:15px;line-height:1.7;color:#A9AFC9;\">support@mysweetpea.cc<br>— Sweet Pea</p>\n            </td>\n          </tr>\n          <!-- Footer -->\n          <tr>\n            <td style=\"padding:24px 32px;border-top:1px solid #16282B;text-align:center;\">\n              <p style=\"margin:0;font-size:12px;color:#9BA1C7;line-height:18px;\">© 2026 MySweetPea. Self-hosted with care.</p>\n              \n            </td>\n          </tr>\n        </table>\n        <p style=\"margin:16px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#9BA1C7;text-align:center;\">Made at home, kept for the people who use it.</p>\n      </td>\n    </tr>\n  </table>\n  </div>\n</div>",
        "text": "=Your MySweetPea account is on hold.\n\nHi {{ $json.name }},\n\nI locked your account because it was still using the temporary password after 14 days. Nothing is lost. Your files and watch history are where you left them.\n\nReply to this email and I will unlock it. Then sign in and set a new password.\n\nSorry for the hassle. This is only so nobody else can get in with an old password.\n\n— Sweet Pea\nsupport@mysweetpea.cc",
        "options": {},
