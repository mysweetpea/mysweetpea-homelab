      "parameters": {
        "jsCode": "const d = $input.first().json.body || {};\nlet err = null;\nif (!d.name || d.name.trim().length < 2) err = 'Could you add your name? (2+ characters)';\nelse if (!d.email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(d.email.trim())) err = 'That email does not look quite right — mind checking it?';\nelse if (d.services && d.services.trim().length > 0 && d.services.trim().length < 2) err = 'Tell us a little about what you are looking for — a few words is plenty.';\n// Form does not send a username - generate a unique placeholder from the email\nconst base = (d.email || '').split('@')[0].toLowerCase().replace(/[^a-z0-9_]/g, '_').slice(0, 20) || 'user';\nd.username = base + '_' + Math.random().toString(36).slice(2, 6);\nreturn [{json: {...d, validation_error: err}}];"
      },
      "typeVersion": 2
    },
