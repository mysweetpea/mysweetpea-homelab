      ],
      "parameters": {
        "options": {
          "responseCode": 400
        },
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ok: false, msg: $json.msg || 'This invite code is not in the garden — double-check it or email support@mysweetpea.cc.'}) }}"
      },
      "typeVersion": 1.1
    },
    {
