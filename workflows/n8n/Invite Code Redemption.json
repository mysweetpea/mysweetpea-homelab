      "type": "n8n-nodes-base.emailSend",
      "position": [
        2432,
        0
      ],
      "webhookId": "def9f55d-b1b1-48ab-bb0b-28907da2781f",
      "parameters": {
        "html": "=<div style=\"background-color:#08090F;padding:26px 12px;width:100%;\">\n  <div style=\"max-width:560px;margin:0 auto;background-color:#121320;border:1px solid #24273A;border-radius:16px;padding:28px 26px 24px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.7;color:#C9CCE4;\">\n      <div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">\r\n    Your MySweetPea account is ready — here are your keys to the garden.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;\r\n  </div>\r\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#08120F\" style=\"width:100%;background-color:#08120F;\">\r\n    <tr>\r\n      <td align=\"center\" style=\"padding:40px 20px;\">\r\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:560px;background-color:#121320;border:1px solid #24273A;border-radius:16px;\">\r\n          <!-- Header -->\r\n          <tr>\r\n            <td align=\"center\" bgcolor=\"#121320\" style=\"background-color:#121320;background:linear-gradient(135deg,#121320,#08120F);padding:44px 32px 26px;border-bottom:1px solid #16282B;\">\r\n              <div style=\"font-family:Georgia,'Times New Roman',serif;font-size:30px;font-weight:700;color:#45D6C8;letter-spacing:-0.5px;\">MySweetPea</div>\r\n              <div style=\"font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#9BA1C7;letter-spacing:2.5px;text-transform:uppercase;margin-top:8px;\">Self-hosted with care</div>\r\n              <div style=\"margin:18px auto 0;width:56px;height:1px;background:#24273A;\">&nbsp;</div>\r\n            </td>\r\n          </tr>\r\n          <!-- Body -->\r\n          <tr>\r\n            <td style=\"padding:36px 32px;font-family:Arial,Helvetica,sans-serif;\">\r\n              <h1 style=\"margin:0 0 18px;font-family:Georgia,'Times New Roman',serif;font-size:24px;font-weight:600;color:#EEF0FB;letter-spacing:-0.3px;\">Welcome in, {{ $('Validate Input').item.json.name }}</h1>\r\n              <p style=\"margin:0 0 18px;font-size:15px;line-height:1.75;color:#A9AFC9;\">Your account exists now. Here is everything you need for the first sign-in.</p>\r\n              <p style=\"margin:0 0 26px;font-size:15px;line-height:1.75;color:#A9AFC9;\">Sign in with these, then pick a password of your own.</p>\r\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#08120F\" style=\"background-color:#08120F;border:1px solid #24273A;border-radius:12px;margin-bottom:8px;\">\r\n                <tr><td style=\"padding:22px 24px;\">\r\n                  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\r\n                    <tr><td style=\"font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#7E85AE;letter-spacing:1.8px;text-transform:uppercase;padding-bottom:12px;border-bottom:1px solid #16282B;\">Your sign-in</td></tr>\r\n                    <tr><td style=\"padding:14px 0 2px;font-size:11px;color:#7E85AE;letter-spacing:1.5px;text-transform:uppercase;\">Sign-in page</td></tr>\r\n                    <tr><td style=\"padding:2px 0 10px;font-size:15px;\"><a href=\"https://dashboard.mysweetpea.cc\" style=\"color:#45D6C8;text-decoration:underline;font-weight:600;\">dashboard.mysweetpea.cc</a></td></tr>\r\n                    <tr><td style=\"font-size:11px;color:#7E85AE;letter-spacing:1.5px;text-transform:uppercase;padding:8px 0 2px;\">Username</td></tr>\r\n                    <tr><td style=\"padding:2px 0 10px;font-size:15px;color:#EEF0FB;font-family:Consolas,'Courier New',monospace;\">{{ $('Validate Input').item.json.username }}</td></tr>\r\n                    <tr><td style=\"font-size:11px;color:#7E85AE;letter-spacing:1.5px;text-transform:uppercase;padding:8px 0 2px;\">Temporary password</td></tr>\r\n                    <tr><td style=\"padding:2px 0 4px;font-size:17px;color:#5ED39E;font-family:Consolas,'Courier New',monospace;font-weight:700;letter-spacing:0.5px;\">{{ $('Generate Temp Password').item.json.temp_password }}</td></tr>\r\n                  </table>\r\n                </td></tr>\r\n              </table>\r\n              <p style=\"margin:14px 0 28px;font-size:13px;line-height:1.7;color:#A9AFC9;\">That password is temporary. When you sign in, open the Account tab and set your own. You have 7 days before I start reminding you, and at 14 days the account is locked until you get in touch.</p>\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border:1px solid #24273A;border-radius:12px;background-color:#08120F;\">\n                <tr><td style=\"padding:22px 24px;\">\n                  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                    <tr><td style=\"font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#7E85AE;letter-spacing:1.8px;text-transform:uppercase;padding-bottom:12px;border-bottom:1px solid #16282B;\">Watch on Moonfin</td></tr>\n                    <tr><td style=\"padding:14px 0 2px;font-size:11px;color:#7E85AE;letter-spacing:1.5px;text-transform:uppercase;\">Your PIN and server address</td></tr>\n                    <tr><td style=\"padding:2px 0 10px;font-size:14px;line-height:1.7;color:#EEF0FB;\">Open the <strong>Media</strong> tab in your dashboard. Your PIN and the Moonfin server address sit at the top of that page.</td></tr>\n                    <tr><td style=\"padding:0 0 4px;font-size:13px;line-height:1.7;color:#A9AFC9;\">There is a 30-second video there that walks through it. Your watch history and favorites stay yours.</td></tr>\n                  </table>\n                </td></tr>\n              </table>\r\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\r\n                <tr>\r\n                  <td align=\"center\" style=\"padding:0 0 28px;\">\r\n                    <!--[if mso]>\r\n                    <v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\" href=\"https://dashboard.mysweetpea.cc\" style=\"height:48px;v-text-anchor:middle;width:260px;\" arcsize=\"20%\" stroke=\"f\" fillcolor=\"#45D6C8\">\r\n                      <w:anchorlock/>\r\n                      <center style=\"color:#08120F;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:600;\">Open your dashboard</center>\r\n                    </v:roundrect>\r\n                    <![endif]-->\r\n                    <!--[if !mso]><!-->\r\n                    <a href=\"https://dashboard.mysweetpea.cc\" style=\"display:inline-block;padding:14px 44px;background-color:#45D6C8;color:#08120F;font-size:15px;font-weight:600;text-decoration:none;border-radius:24px;font-family:Arial,Helvetica,sans-serif;\">Open your dashboard</a>\r\n                    <!--<![endif]-->\r\n                  </td>\r\n                </tr>\r\n              </table>\r\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#12201C\" style=\"background-color:#12201C;border:1px solid #1E3A2E;border-radius:10px;margin-bottom:26px;\">\r\n                <tr><td style=\"padding:14px 18px;font-size:13px;color:#A9DCC2;line-height:1.7;\">One more thing: do not forward this email. The password stops working once you change it, but until then it is the key to your account.</td></tr>\r\n              </table>\r\n              <p style=\"margin:0;font-size:15px;line-height:1.75;color:#A9AFC9;\">If anything does not work, reply to this email. I read every one.</p>\r\n            </td>\r\n          </tr>\r\n          <!-- Footer -->\r\n          <tr>\r\n            <td style=\"padding:24px 32px;border-top:1px solid #16282B;text-align:center;\">\r\n              <p style=\"margin:0 0 6px;font-family:Georgia,'Times New Roman',serif;font-size:12px;color:#9BA1C7;letter-spacing:1px;\">🌱 grown at home, kept for the people who use it</p>\r\n              <p style=\"margin:0;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#9BA1C7;line-height:18px;\">© 2026 MySweetPea · <a href=\"https://mysweetpea.cc\" style=\"color:#9BA1C7;text-decoration:underline;\">mysweetpea.cc</a></p>\r\n            </td>\r\n          </tr>\r\n        </table>\r\n      </td>\r\n    </tr>\r\n  </table>\n  </div>\n</div>",
        "text": "=Your MySweetPea account is ready.\n\nHi {{ $('Validate Input').item.json.name }},\n\nYour account exists now. Here is everything you need for the first sign-in.\n\nSign in: https://dashboard.mysweetpea.cc\nUsername: {{ $('Validate Input').item.json.username }}\nTemporary password: {{ $('Generate Temp Password').item.json.temp_password }}\n\nThat password is temporary. When you sign in, open the Account tab and set your own. You have 7 days before I start reminding you, and at 14 days the account is locked until you get in touch.\n\nWatching on Moonfin:\nOpen the Media tab in your dashboard. Your PIN and the Moonfin server address sit at the top of that page, and there is a 30-second video that walks through it. Your watch history and favorites stay yours.\n\nOne more thing: do not forward this email. The password stops working once you change it, but until then it is the key to your account.\n\nIf anything does not work, reply to this email. I read every one.\n\n— Sweet Pea\nMySweetPea · https://mysweetpea.cc",
        "options": {},
        "subject": "Your MySweetPea account is ready",
        "toEmail": "={{ $('Validate Input').item.json.email }}",
        "fromEmail": "MySweetPea <support@mysweetpea.cc>",
