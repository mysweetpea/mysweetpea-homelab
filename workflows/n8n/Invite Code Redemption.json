{
  "name": "Invite Code Redemption",
  "nodes": [
    {
      "id": "3e38cbc6-b6a4-4380-a0c5-dfc701a7e70b",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [
        0,
        0
      ],
      "webhookId": "rc-001",
      "parameters": {
        "path": "redeem-code",
        "options": {},
        "httpMethod": "POST",
        "responseMode": "responseNode"
      },
      "typeVersion": 2.1
    },
    {
      "id": "74245560-ec08-495e-b3b6-3836b071c066",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "position": [
        224,
        0
      ],
      "parameters": {
        "jsCode": "const d = $input.first().json.body || {};\n\nconst inviteCode = String(d.invite_code || '').trim();\n\nlet err = null;\n\nif (!/^(PEA|FAM)-[A-Z0-9]{8}$/.test(inviteCode)) {\n  err = 'That does not match an invite code format — they look like PEA-7KJXU2YK or FAM-9YG7JQ5T.';\n} else if (!d.name || d.name.trim().length < 2) {\n  err = 'Could you add your name? (2+ characters)';\n} else if (!d.email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(d.email.trim())) {\n  err = 'That email does not look quite right — mind checking it?';\n} else if (!d.username || !/^[a-zA-Z0-9_]{3,}$/.test(d.username.trim())) {\n  err = 'Usernames need 3+ characters — letters, numbers, or underscores only.';\n}\n\nreturn [{\n  json: {\n    ...d,\n    invite_code: inviteCode,\n    validation_error: err,\n  },\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "44b85837-33e2-402e-8d1c-f3cc37595da0",
      "name": "Input Valid?",
      "type": "n8n-nodes-base.if",
      "position": [
        448,
        0
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 1,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "string",
                "operation": "empty"
              },
              "leftValue": "={{ $json.validation_error }}",
              "rightValue": ""
            }
          ]
        }
      },
      "typeVersion": 2
    },
    {
      "id": "1736bad1-d58a-499d-8000-925529d4a2ad",
      "name": "Error Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        672,
        208
      ],
      "parameters": {
        "options": {
          "responseCode": 400
        },
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ok: false, msg: $json.validation_error}) }}"
      },
      "typeVersion": 1.1
    },
    {
      "id": "40a39e16-e2fe-43e5-8e1c-4de812e420b4",
      "name": "Check Code",
      "type": "n8n-nodes-base.postgres",
      "position": [
        672,
        0
      ],
      "parameters": {
        "query": "SELECT id, code, tier, used,\n  CASE WHEN used = false THEN true ELSE false END as valid,\n  CASE WHEN used = true THEN 'Invite code already redeemed.' ELSE 'Invite code is valid.' END as msg\nFROM invite_codes WHERE code = $1\nUNION ALL\nSELECT NULL::int, NULL::text, NULL::text, false, false, 'Invite code not found.'\nWHERE NOT EXISTS (SELECT 1 FROM invite_codes WHERE code = $2);",
        "options": {
          "queryReplacement": "={{ $json.invite_code }}, {{ $json.invite_code }}"
        },
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "yPSJ6t0yTl3JfbWz",
          "name": "Postgres"
        }
      },
      "typeVersion": 2.3
    },
    {
      "id": "fb2495fd-5aee-4f8e-9b12-48cf1ca60052",
      "name": "Code Valid?",
      "type": "n8n-nodes-base.if",
      "position": [
        1104,
        0
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 1,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "boolean",
                "operation": "equals"
              },
              "leftValue": "={{ $json.valid }}",
              "rightValue": true
            }
          ]
        }
      },
      "typeVersion": 2
    },
    {
      "id": "d8391f51-3abe-4aeb-bd50-24a5a8ce9b8b",
      "name": "Code Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
